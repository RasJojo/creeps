# Réglages du backend de la banque (copier vers .env sur la machine de déploiement; ne jamais committer .env).
# Doivent correspondre aux réglages "third-party auth" du fournisseur de wallet.
BANK_ISSUER=https://sso.swissquote.test
BANK_AUDIENCE=dynamic
BANK_KID=creeps-1

# Origines autorisées à appeler l'API, séparées par des virgules: l'adresse publique de l'application, et
# http://localhost:5173 pour développer l'interface contre cette banque.
BANK_ALLOWED_ORIGINS=https://creeps.example.com,http://localhost:5173
# Mettre à 1 dès que l'application est servie en HTTPS.
BANK_SECURE_COOKIES=1

# Délai avant d'autoriser un NOUVEAU passkey (60 s pour tester; 24 à 72 h en production).
BANK_RECOVERY_DELAY_SECONDS=60
BANK_REAUTH_WINDOW_SECONDS=300

# Inscriptions limitées à ces adresses (jokers *, séparées par des virgules).
BANK_ALLOWED_EMAILS=*@example.ch
