# Copier vers .env (ignoré par git). L'environment ID Dynamic est public côté client.
VITE_DYNAMIC_ENVIRONMENT_ID=

# Banque appelée par le serveur de développement (npm run dev), sur /api. Par défaut: le tunnel SSH local ci-dessous.
# Pour utiliser la banque déployée, mettre son adresse publique (elle doit autoriser http://localhost:5173, voir server/.env.example):
# BANK_URL=https://creeps.example.com

# Tunnel SSH vers le socket d'administration de la banque (npm run bank:tunnel).
BANK_SSH_HOST=mon-serveur
BANK_SOCKET_PATH=/chemin/du/deploiement/run/api.sock
